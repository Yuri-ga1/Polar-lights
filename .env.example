# Copy to .env; set UID/GID from id -u / id -g. Environment needs recreate.
POLAR_UID=1000
POLAR_GID=1000
WEB_PORT=8080
API_CPUS=1.0
API_MEMORY=2g
WORKER_CPUS=2.0
WORKER_MEMORY=4g
WORKER_SHM=1g
# Supports worst-case bounded shutdown with up to 64 configured job_workers.
WORKER_STOP_GRACE=420s
FRONTEND_CPUS=0.5
FRONTEND_MEMORY=256m
# Local-only default. Public deployments require an authenticating TLS gateway.
POLAR_API_KEY=
SIMURG_EMAIL=
# Retention is explicit offline maintenance, dry-run by default (see docs).
JOB_RETENTION_DAYS=30
