{
  "name": "polar-lights-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts",
    "format": "prettier --write src tests *.ts *.json *.html *.md",
    "format:check": "prettier --check src tests *.ts *.json *.html *.md"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.80.0",
    "apache-arrow": "^20.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "maplibre-gl": "5.6.1",
    "plotly.js-cartesian-dist-min": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-rnd": "^10.5.2",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/plotly.js": "^3.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
